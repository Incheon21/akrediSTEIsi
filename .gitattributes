# Enforce Unix line endings for files that run inside Linux containers
*.sh        text eol=lf
*.py        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sql       text eol=lf
*.env*      text eol=lf

# Windows-specific files keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
