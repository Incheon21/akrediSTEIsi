# Public domain for Caddy.
# Use your real domain after pointing its DNS A record to the VPS IP.
DOMAIN=example.com

# Leave empty to call the API on the same origin through Caddy (/api/...).
NEXT_PUBLIC_API_URL=

# PostgreSQL
POSTGRES_USER=stei
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=stei_accreditation

# Optional image tag names for the locally built images.
CI_REGISTRY_IMAGE=stei
TAG=latest
