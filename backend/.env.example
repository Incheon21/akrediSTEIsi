# Application
APP_ENV=development
APP_NAME="STEI Accreditation System"

# Database (PostgreSQL)
# When running via Docker Compose, use the service name "db" as the host
# When running locally outside Docker, use "localhost"
DATABASE_URL=postgresql://postgres:postgres@db:5432/stei_accreditation

# PostgreSQL credentials (used by Docker Compose to initialize the DB container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stei_accreditation

# JWT
# Generate a strong secret with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
